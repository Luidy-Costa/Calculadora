FLASK_ENV=development
SECRET_KEY=sua-chave-secreta-super-segura

# Conexão com o Banco de Dados (SQLAlchemy)
# Padrão SQLite:
DATABASE_URL=sqlite:///emprestados.db

# Exemplo de migração para PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/emprestados_db

# Sentry DSN (obtenha em sentry.io > Projeto > Settings > Client Keys (DSN))
SENTRY_DSN=
